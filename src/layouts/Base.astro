---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangToggle from '../components/LangToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'juank — Juan Carlos Vallejo Ruiz',
  description = 'Full-Stack Dev & AI Builder. Building AI-powered tools and products from Terrassa, Barcelona.',
} = Astro.props;

const canonicalURL = 'https://carlosvallejoruiz.github.io';
const ogImage      = `${canonicalURL}/images/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Inline theme script — must run before CSS to avoid FOUC -->
    <!-- Default is always light; dark only if explicitly saved by user -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('juank-theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
          var lang = localStorage.getItem('juank-lang') || 'es';
          document.documentElement.lang = lang;
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E8E4DC" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,900&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-left">
          <a href="/" class="header-brand">juank.dev</a>
          <span class="header-sep" aria-hidden="true">|</span>
        </div>
        <div class="header-right">
          <LangToggle />
          <span class="header-sep" aria-hidden="true">|</span>
          <ThemeToggle />
          <span class="header-sep" aria-hidden="true">|</span>
          <span class="header-version">v01.2026</span>
        </div>
      </div>
    </header>

    <slot />

    <script>
      import { translations } from '../data/translations';
      import type { Lang } from '../data/translations';

      // ── Fade-in observer ──────────────────────────────────────
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 },
      );
      document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));

      // ── i18n ─────────────────────────────────────────────────
      function applyTranslations(lang: Lang) {
        const t = translations[lang];
        const tAny = t as Record<string, unknown>;

        // Static string keys (data-i18n="key")
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const val = tAny[el.dataset.i18n!];
          if (typeof val === 'string') el.textContent = val;
        });

        // Project-specific bilingual elements (data-i18n-en / data-i18n-es)
        document.querySelectorAll<HTMLElement>('[data-i18n-en]').forEach((el) => {
          el.textContent = lang === 'es'
            ? (el.dataset.i18nEs ?? el.dataset.i18nEn ?? '')
            : (el.dataset.i18nEn ?? '');
        });

        // About paragraphs (data-about-index="0..3")
        document.querySelectorAll<HTMLElement>('[data-about-index]').forEach((el) => {
          const idx = parseInt(el.dataset.aboutIndex ?? '0', 10);
          const para = t.aboutText[idx];
          if (para !== undefined) el.textContent = para;
        });

        // Ticker — rebuild both copies with coloured dots
        const tickerParts = document.querySelectorAll<HTMLElement>('[data-ticker-part]');
        const segs = t.tickerSegments as readonly string[];
        const tickerHTML = segs
          .map((seg, i) => (i > 0 ? '<span class="ticker-dot"> · </span>' : '') + seg)
          .join('') + '<span class="ticker-dot"> · </span>';
        tickerParts.forEach((el) => { el.innerHTML = tickerHTML; });
      }

      // Apply saved lang on load (LangToggle sets UI only; this handles text)
      const initLang = (() => {
        try { return (localStorage.getItem('juank-lang') ?? 'es') as Lang; } catch (_) { return 'es' as Lang; }
      })();
      if (initLang !== 'en') applyTranslations(initLang);

      // React to user toggle
      document.addEventListener('langchange', (e: Event) => {
        const lang = (e as CustomEvent<{ lang: Lang }>).detail.lang;
        applyTranslations(lang);
      });
    </script>
  </body>
</html>

<style is:global>
  body {
    padding-top: 40px;                    /* fixed header */
    padding-bottom: calc(1.5rem + 72px); /* footer padding + ticker (44px) + status (28px) */
  }
</style>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 40px;
    background: var(--color-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 0 2rem;
  }

  @media (max-width: 640px) {
    .header-inner {
      padding: 0 1rem;
    }
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-brand {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .header-sep {
    font-size: var(--text-sm);
    color: var(--color-border);
    user-select: none;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-version {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
