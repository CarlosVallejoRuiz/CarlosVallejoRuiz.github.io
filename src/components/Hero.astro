<style>
  /* ============================================================
     HERO WRAPPER
     ============================================================ */
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-12) var(--space-8) var(--space-8);
  }

  /* ============================================================
     NAME — h1
     ============================================================ */
  .hero-name {
    font-family: var(--font-display);
    line-height: 0.88;
    margin-bottom: 0;
  }

  .name-juank {
    display: block;
    font-size: var(--text-hero);
    font-weight: 900;
    font-style: normal;
    color: var(--color-ink);
  }

  .name-ca {
    display: block;
    font-size: var(--text-hero);
    font-weight: 900;
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-border);
  }

  /* ============================================================
     DIVIDER
     ============================================================ */
  .hero-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    width: 60%;
    margin: var(--space-6) 0;
  }

  /* ============================================================
     LABEL
     ============================================================ */
  .hero-label {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-6);
  }

  /* ============================================================
     BIO
     ============================================================ */
  .hero-bio {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-email {
    color: var(--color-accent);
    text-decoration: none;
  }

  .hero-email:hover {
    text-decoration: underline;
  }

  /* ============================================================
     SECONDARY DATA
     ============================================================ */
  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: 2rem;
  }

  .hero-meta p {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .hero-meta-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }

  .hero-meta-link:hover {
    text-decoration: underline;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ============================================================
     ABOUT BLOCK
     ============================================================ */
  .about-block {
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .about-block summary {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    user-select: none;
  }

  .about-block summary::-webkit-details-marker {
    display: none;
  }

  .about-block summary::before {
    content: "+";
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: 1;
    color: var(--color-accent);
  }

  .about-block[open] summary::before {
    content: "−";
  }

  .about-content {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.8;
    margin-top: 1rem;
  }

  .about-content p {
    margin-bottom: 1rem;
  }

  .about-content p:last-child {
    margin-bottom: 0;
  }
</style>
